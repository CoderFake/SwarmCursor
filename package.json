{
  "name": "swarm-cursor",
  "version": "2.0.0",
  "description": "SwarmCursor 2.0: Compiled Rust/WASM multi-agent Figma cursor choreography, 3D/Three.js/GLB builder (extrude, GPU particle swarm, holographic slice), deep DOM scanner, and zero-React-tick renderer",
  "author": "CoderFake",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CoderFake/SwarmCursor.git"
  },
  "homepage": "https://sc-hd.vercel.app",
  "bugs": {
    "url": "https://github.com/CoderFake/SwarmCursor/issues"
  },
  "keywords": [
    "cursor",
    "swarm",
    "figma-cursor",
    "multi-agent",
    "boids",
    "threejs",
    "glb",
    "webgl",
    "wasm",
    "rust",
    "scroll-animation",
    "react",
    "typescript"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./engine": {
      "types": "./dist/engine/index.d.ts",
      "import": "./dist/engine/index.js",
      "require": "./dist/engine/index.cjs"
    },
    "./kernel": {
      "types": "./dist/kernel/index.d.ts",
      "import": "./dist/kernel/index.js",
      "require": "./dist/kernel/index.cjs"
    },
    "./three": {
      "types": "./dist/three/index.d.ts",
      "import": "./dist/three/index.js",
      "require": "./dist/three/index.cjs"
    },
    "./scanner": {
      "types": "./dist/scanner/index.d.ts",
      "import": "./dist/scanner/index.js",
      "require": "./dist/scanner/index.cjs"
    },
    "./renderers": {
      "types": "./dist/renderers/index.d.ts",
      "import": "./dist/renderers/index.js",
      "require": "./dist/renderers/index.cjs"
    },
    "./tools": {
      "types": "./dist/tools/index.d.ts",
      "import": "./dist/tools/index.js",
      "require": "./dist/tools/index.cjs"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "require": "./dist/react/index.cjs"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "skills",
    "README.md"
  ],
  "scripts": {
    "build": "npm run build:lib",
    "build:lib": "tsup && cp src/styles/swarm-cursor.css dist/styles.css",
    "build:skills": "npx esbuild src/site/exportSkillsCli.ts --bundle --platform=node --format=esm --outfile=dist-site/.export-skills.mjs && node dist-site/.export-skills.mjs && rm -f dist-site/.export-skills.mjs",
    "build:site": "mkdir -p dist-site && npm run build:skills && cp src/styles/swarm-cursor.css dist-site/styles.css && cp src/site/styles.css dist-site/docs-site.css && cp src/presets/logo-cf.svg dist-site/logo-cf.svg && cp src/presets/index.html dist-site/index.html && npx esbuild src/presets/landing-demo.tsx --bundle --format=esm --minify --outfile=dist-site/landing-demo.js",
    "prepare": "npm run build:lib",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^24.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
