{
  "name": "swarm-cursor",
  "version": "2.0.0",
  "description": "SwarmCursor 2.0: Compiled Rust/WASM multi-agent Figma cursor choreography, 3D/Three.js/GLB builder (extrude, GPU particle swarm, holographic slice), deep DOM scanner, and zero-React-tick renderer",
  "author": "CoderFake",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CoderFake/SwarmCursor.git"
  },
  "homepage": "https://github.com/CoderFake/SwarmCursor#readme",
  "bugs": {
    "url": "https://github.com/CoderFake/SwarmCursor/issues"
  },
  "keywords": [
    "cursor",
    "swarm",
    "figma-cursor",
    "multi-agent",
    "boids",
    "threejs",
    "glb",
    "webgl",
    "wasm",
    "rust",
    "scroll-animation",
    "react",
    "typescript"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "require": "./dist/react/index.cjs"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "docs",
    "README.md"
  ],
  "scripts": {
    "build": "tsup && cp src/styles/swarm-cursor.css dist/styles.css",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^24.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
